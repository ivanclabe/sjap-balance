# Copia este archivo como .env y completa con los datos de TU proyecto Supabase
# (Dashboard → Project Settings → API). Ambos valores son públicos: quedan
# dentro del bundle del navegador. Nunca pongas aquí la service_role key.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-o-publishable-key>
